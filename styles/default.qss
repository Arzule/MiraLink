/* name: Oscuro (predeterminado) */
QWidget {
    background-color: #101019;
    color: #F3F3FA;
    font-size: $FONT_BASE;
}

#card {
    background-color: #181829;
    border: 1px solid #2E2E4A;
    border-radius: 16px;
    padding: 16px;
}

#title {
    font-size: $FONT_TITLE;
    color: #F3F3FA;
    font-weight: 700;
}

#subtitle {
    font-size: $FONT_BASE;
    color: #A1A1BE;
}

#description {
    font-size: $FONT_BASE;
    color: #A1A1BE;
    background: transparent;
}

#valueBox, #statusBadge {
    font-size: $FONT_BASE;
    color: #F3F3FA;
    padding: 4px 8px;
    border-radius: 8px;
    border: 1px solid #2E2E4A;
    background: transparent;
}

QLabel, QSlider, #card QWidget {
    background: transparent;
}

QPushButton {
    min-height: 48px;
    border-radius: 12px;
    padding: 8px 16px;
    font-size: $FONT_BASE;
}

QPushButton[variant="primary"] {
    background-color: #8070FF;
    color: #F3F3FA;
    border: none;
}

QPushButton[variant="secondary"] {
    background-color: transparent;
    color: #F3F3FA;
    border: 2px solid #8070FF;
}

QSlider {
    min-height: 48px;
}
QSlider::groove:horizontal {
    border: none;
    height: 8px;
    background: #2E2E4A;
    border-radius: 4px;
}
QSlider::handle:horizontal {
    background: #8070FF;
    border: none;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    margin: -8px 0;
}

QSpinBox {
    min-height: 48px;
    font-size: $FONT_BASE;
    padding: 4px 8px;
    border-radius: 8px;
    border: 1px solid #2E2E4A;
    background-color: #181829;
    color: #F3F3FA;
}

QComboBox {
    min-height: 48px;
    font-size: $FONT_BASE;
    padding: 4px 8px;
    border-radius: 8px;
    border: 1px solid #2E2E4A;
    background-color: #181829;
    color: #F3F3FA;
}

/* Popup del combo: reglas opacas; el selector con #card evita que la regla transparente lo alcance */
QComboBox QAbstractItemView,
#card QComboBox QAbstractItemView,
#card QComboBox QAbstractItemView QWidget {
    background-color: #181829;
    color: #F3F3FA;
    border: 2px solid #2E2E4A;
    selection-background-color: #8070FF;
    selection-color: #101019;
    outline: 0;
}

QComboBox QAbstractItemView::item,
#card QComboBox QAbstractItemView::item {
    min-height: 48px;
    padding: 4px 8px;
}

/* Botones − / + de tamaño de letra: tamaño fijo 48x48, sin relleno que los recorte */
QPushButton#btn_font_minus, QPushButton#btn_font_plus {
    min-height: 0px;
    padding: 0px;
}
